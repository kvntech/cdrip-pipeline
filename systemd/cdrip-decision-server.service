[Unit]
Description=cdrip-pipeline: decision relay server (Phase 4 remote prompts via Home Assistant)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=kevin
WorkingDirectory=/home/kevin/projects/cdrip-pipeline
EnvironmentFile=/home/kevin/projects/cdrip-pipeline/.env
ExecStart=/usr/bin/python3 /home/kevin/projects/cdrip-pipeline/decision_server.py --port 8420
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Unlike cdrip.service (oneshot, triggered per-disc by udev), this is a
# long-running listener -- it needs to be up at all times so Home Assistant
# always has somewhere to relay a tapped notification action to. Enable it
# to start at boot:
#   sudo systemctl enable --now cdrip-decision-server.service
#
# Firewall this port (8420) to your Tailscale interface only -- see
# docs/phase4-runbook.md for an example. Don't rely on CDRIP_DECISION_SECRET
# alone; it's defense-in-depth, not a substitute for network-level
# restriction.

[Install]
WantedBy=multi-user.target
